id: nda_intake
title: NDA Intake
description: |
  Worked example of the M2 prefill chain. The user reaches this flow via
  Fast2Flow Dispatch with their natural-language utterance. The
  slot-extractor parses counterparty + due_date out of that utterance,
  and the adaptive card opens with those fields already filled.
type: messaging
start: extract_slots
schema_version: 2

# M2.4a — flow-level slot definitions consumed by the slot-extractor.
# Each entry mirrors `component-slot-extractor`'s SlotDefinition wire shape.
# Authoring tools, Fast2Flow scoping, and runtime wiring all read from this
# single source of truth. Phase D runtime injects this directly into the
# extractor's `slot_definitions` input when the node omits it
# (greentic-runner >= 1.1.26775859893).
slot_schema:
  - name: counterparty
    slot_type: string
    pattern: 'between\s+([A-Z][\w&. ]*?)\s+and'
    required: true
  - name: due_date
    slot_type: date
    required: true

nodes:
  extract_slots:
    component.exec:
      component: ai.greentic.component-slot-extractor
      payload:
        utterance: "{{dispatch.utterance}}"
    operation: extract_slots
    routing:
      - to: render_form

  render_form:
    component.exec:
      component: ai.greentic.component-adaptive-card
      payload:
        card:
          type: AdaptiveCard
          version: "1.5"
          body:
            - type: TextBlock
              text: "Start an NDA"
              weight: Bolder
              size: Large
            - type: Input.Text
              id: counterparty
              label: "Counterparty"
              isRequired: true
            - type: Input.Date
              id: due_date
              label: "Due date"
              isRequired: true
          actions:
            - type: Action.Submit
              title: "Generate draft"
        # M2.3 — `prefill` populates Input.value at render time. Precedence:
        # prefill > payload > session > state > template_params. The
        # extractor's per-slot value map drops straight in.
        prefill:
          counterparty: "{{extract_slots.values.counterparty}}"
          due_date: "{{extract_slots.values.due_date}}"
    operation: render
    routing:
      - reply: true
